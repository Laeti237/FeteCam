<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.BilanPage"
             Title="Bilan"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="#24FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 17" Padding="12,7" VerticalOptions="Center">
                        <Label FontSize="14" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="‹ " TextColor="{StaticResource Accent}" />
                                    <Span Text="Retour" TextColor="White" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Bilan" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Mariage Alain &amp; Rose · Terminé" FontSize="12" TextColor="#DCE8E2" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="12">
                <!-- 2x2 Key Stats -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="2,0 M" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Contributions" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="1,8 M" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Dépenses" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="+200 K" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                            <Label Text="Solde" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="92 %" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Présence (110 invités)" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Dépenses par poste -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Dépenses par poste" Style="{StaticResource SectionTitle}" />

                        <!-- Traiteur -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Traiteur" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" Text="600 000 / 700 000 FCFA" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </Grid>
                            <ProgressBar Progress="0.85" ProgressColor="{StaticResource PrimaryLight}" HeightRequest="5" />
                        </VerticalStackLayout>

                        <!-- Salle -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Salle" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" Text="400 000 / 400 000 FCFA" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </Grid>
                            <ProgressBar Progress="1.0" ProgressColor="{StaticResource Success}" HeightRequest="5" />
                        </VerticalStackLayout>

                        <!-- Boissons -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Boissons" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" Text="210 000 / 200 000 FCFA" FontSize="12" TextColor="{StaticResource Error}" />
                            </Grid>
                            <ProgressBar Progress="1.0" ProgressColor="{StaticResource Error}" HeightRequest="5" />
                        </VerticalStackLayout>

                        <!-- Décoration -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Décoration" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" Text="90 000 / 250 000 FCFA" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </Grid>
                            <ProgressBar Progress="0.36" ProgressColor="{StaticResource Accent}" HeightRequest="5" />
                        </VerticalStackLayout>

                        <!-- Musique -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Musique" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" Text="60 000 / 150 000 FCFA" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </Grid>
                            <ProgressBar Progress="0.40" ProgressColor="{StaticResource Accent}" HeightRequest="5" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Actions: Export & Partage -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,8">
                    <Button Text="Exporter en PDF" Style="{StaticResource PrimaryButton}" Clicked="OnExportClicked" />
                    <Button Grid.Column="1" Text="Partager le lien" Style="{StaticResource SecondaryButton}" Clicked="OnShareClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Tab Navigation -->
        <Border Grid.Row="2" Style="{StaticResource BottomNavBar}">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavAccueilTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Accueil" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavInvitesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Invités" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavBudgetTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Budget" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTachesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Tâches" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfilTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Profil" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
