<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.DetailInvitePage"
             Title="Détail de l'invité"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="#24FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 17" Padding="12,7" VerticalOptions="Center">
                        <Label FontSize="14" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="‹ " TextColor="{StaticResource Accent}" />
                                    <Span Text="Retour" TextColor="White" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="HeaderNameLabel" Text="Fiche Invité" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="SubtitleLabel" Text="Mariage Alain &amp; Rose" FontSize="12" TextColor="#DCE8E2" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="14">
                <!-- Contact Card -->
                <Border Style="{StaticResource CardFrame}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="{StaticResource Primary}" Stroke="Transparent" VerticalOptions="Center">
                            <Label x:Name="InitialsLabel" Text="MN" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalOptions="Center">
                            <Label x:Name="GuestNameLabel" Text="Marie Ngono" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label x:Name="GuestPhoneLabel" Text="+237 671 22 33 44" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Information Details -->
                <Label Text="Informations de présence" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Statut de confirmation" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                            <Border Grid.Column="1" BackgroundColor="{StaticResource SuccessLight}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="6,4" WidthRequest="84" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label x:Name="StatusLabel" Text="Confirmé" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Success}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Nombre de places" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" x:Name="PlacesLabel" Text="2 personnes" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Table assignée" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" x:Name="TableLabel" Text="Table d'honneur" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Communication Actions -->
                <Label Text="Contact &amp; Échanges" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Appeler" Style="{StaticResource SecondaryButton}" Clicked="OnCallClicked" />
                    <Button Grid.Column="1" Text="Message" Style="{StaticResource SecondaryButton}" Clicked="OnMessageClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action: Delete Guest -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="14,10,14,16">
            <Button Text="Retirer de la liste" TextColor="{StaticResource Error}" BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Border}" BorderWidth="1" CornerRadius="10" HeightRequest="48" FontAttributes="Bold" Clicked="OnDeleteGuestClicked" />
        </Border>
    </Grid>
</ContentPage>
