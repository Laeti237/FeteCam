<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.MesEvenementsPage"
             Title="Mes événements"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹ Retour" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                </HorizontalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Mes événements" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="SubtitleLabel" Text="0 événement(s)" FontSize="12" TextColor="#DCE8E2" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="12">
                <VerticalStackLayout x:Name="EventsContainer" Spacing="12" />

                <Button Text="+ Nouvel événement" Style="{StaticResource PrimaryButton}" Clicked="OnAddEventClicked" Margin="0,4,0,8" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="14,10,14,16">
            <Button Text="Voir le prochain événement" Style="{StaticResource SecondaryButton}" Clicked="OnNextEventClicked" />
        </Border>
    </Grid>
</ContentPage>
