<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.ResponsablesPage"
             Title="Responsables"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="#24FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 17" Padding="12,7" VerticalOptions="Center">
                        <Label FontSize="14" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="‹ " TextColor="{StaticResource Accent}" />
                                    <Span Text="Retour" TextColor="White" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Comité d'organisation" FontSize="18" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="SubtitleLabel" Text="Tous les événements · Responsables" FontSize="12" TextColor="#DCE8E2" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="+ Inviter" FontSize="12" FontAttributes="Bold" BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource TextPrimary}" HeightRequest="36" Padding="12,0" CornerRadius="8" Clicked="OnAddResponsibleClicked" AutomationId="AddTopButton" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content: List of Responsibles -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="MembersHeader" Text="Membres du comité" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />

                <!-- Container populated dynamically -->
                <VerticalStackLayout x:Name="ResponsiblesContainer" Spacing="10" />

                <Label x:Name="SentHeader" Text="Invitations envoyées" Style="{StaticResource SectionTitle}" Margin="2,10,0,0" IsVisible="False" AutomationId="SentHeader" />
                <VerticalStackLayout x:Name="SentContainer" Spacing="10" AutomationId="SentContainer" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Button -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="14,10,14,16">
            <Button Text="+ Inviter un responsable" Style="{StaticResource PrimaryButton}" Clicked="OnAddResponsibleClicked" AutomationId="AddButton" />
        </Border>
    </Grid>
</ContentPage>
