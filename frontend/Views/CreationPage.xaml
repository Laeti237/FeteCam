<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.CreationPage"
             Title="Nouvel événement"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="#24FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 17" Padding="12,7" VerticalOptions="Center">
                        <Label FontSize="14" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="‹ " TextColor="{StaticResource Accent}" />
                                    <Span Text="Retour" TextColor="White" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="HeaderTitleLabel" Text="Nouvel événement" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="HeaderSubtitleLabel" Text="Étape 1 sur 3 · Type et détails" FontSize="12" TextColor="#DCE8E2" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Form ScrollView -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="14">
                <!-- Type de cérémonie -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Type de cérémonie" Style="{StaticResource SectionTitle}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 20" Stroke="Transparent" Padding="16,8" Margin="0,0,8,6">
                            <Label Text="Mariage" FontSize="13" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 20" Stroke="{StaticResource Border}" Padding="16,8" Margin="0,0,8,6">
                            <Label Text="Deuil" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 20" Stroke="{StaticResource Border}" Padding="16,8" Margin="0,0,8,6">
                            <Label Text="Anniversaire" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 20" Stroke="{StaticResource Border}" Padding="16,8" Margin="0,0,8,6">
                            <Label Text="Autre" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Input Fields in Card -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nom de la cérémonie" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="10,0" BackgroundColor="{StaticResource Surface}">
                                <Entry x:Name="NameEntry" AutomationId="NameEntry" Placeholder="Ex. Mariage Alain &amp; Rose" Text="Mariage Alain &amp; Rose" Style="{StaticResource StyledEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Date et heure" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="10,0" BackgroundColor="{StaticResource Surface}">
                                <Entry x:Name="DateEntry" AutomationId="DateEntry" Placeholder="JJ/MM/AAAA · HH:MM" Text="14/12/2026 · 14:00" Style="{StaticResource StyledEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Lieu" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="10,0" BackgroundColor="{StaticResource Surface}">
                                <Entry x:Name="LocationEntry" AutomationId="LocationEntry" Placeholder="Ville, salle" Text="Douala, Bonanjo" Style="{StaticResource StyledEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Statut" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <FlexLayout x:Name="StatusChipsLayout" Wrap="Wrap" JustifyContent="Start" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Budget prévisionnel (FCFA)" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="10,0" BackgroundColor="{StaticResource Surface}">
                                <Entry x:Name="BudgetEntry" AutomationId="BudgetEntry" Placeholder="Montant FCFA" Text="2 000 000" Keyboard="Numeric" Style="{StaticResource StyledEntry}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Button -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="14,10,14,16">
            <Button x:Name="CreateButton" Text="Créer l'événement" Style="{StaticResource PrimaryButton}" Clicked="OnCreateClicked" AutomationId="SubmitButton" />
        </Border>
    </Grid>
</ContentPage>
