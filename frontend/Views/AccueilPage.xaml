<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.AccueilPage"
             Title="Accueil"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="FêteCam" FontSize="20" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Mes cérémonies · 3 en cours" FontSize="12" TextColor="#DCE8E2" />
                </VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" Stroke="Transparent" BackgroundColor="{StaticResource PrimaryLight}" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfilTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="LN" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="12">
                <!-- Prochaine échéance -->
                <Border BackgroundColor="#FFF9EB" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}" Padding="14,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeadlineTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="PROCHAINE ÉCHÉANCE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource AccentDark}" />
                            <Border Grid.Column="1" BackgroundColor="{StaticResource WarningLight}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="6,2">
                                <Label Text="J-5" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                            </Border>
                        </Grid>
                        <Label Text="Réserver la salle de réception" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <ProgressBar Progress="0.75" ProgressColor="{StaticResource Accent}" HeightRequest="5" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section title -->
                <Label Text="Événements" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />

                <!-- Event 1: Mariage Alain & Rose -->
                <Border Style="{StaticResource CardFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEventTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" BackgroundColor="{StaticResource Primary}" Stroke="Transparent" VerticalOptions="Center">
                                <Label Text="AR" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="Mariage Alain &amp; Rose" Style="{StaticResource SectionTitle}" />
                                <Label Text="14 déc. · Douala" Style="{StaticResource CaptionText}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource SuccessLight}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3" VerticalOptions="Start">
                                <Label Text="Confirmé" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Invités" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="86 / 120" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Budget" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="68 %" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="1">
                                <Label Text="Collecté" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="1,2 M FCFA" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Event 2: Anniversaire 50 ans -->
                <Border Style="{StaticResource CardFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEventTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" BackgroundColor="{StaticResource PrimaryLight}" Stroke="Transparent" VerticalOptions="Center">
                                <Label Text="50" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="Anniversaire 50 ans" Style="{StaticResource SectionTitle}" />
                                <Label Text="28 nov. · Yaoundé" Style="{StaticResource CaptionText}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource WarningLight}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3" VerticalOptions="Start">
                                <Label Text="En préparation" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Invités" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="45 / 50" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Budget" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="40 %" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="1">
                                <Label Text="Collecté" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="650 K FCFA" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Event 3: Veillée Mama Thérèse -->
                <Border Style="{StaticResource CardFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEventTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" BackgroundColor="{StaticResource TextSecondary}" Stroke="Transparent" VerticalOptions="Center">
                                <Label Text="MT" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="Veillée Mama Thérèse" Style="{StaticResource SectionTitle}" />
                                <Label Text="02 nov. · Bafoussam" Style="{StaticResource CaptionText}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource ErrorLight}" StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3" VerticalOptions="Start">
                                <Label Text="Bientôt" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Error}" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Invités" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="110" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Budget" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="90 %" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="1">
                                <Label Text="Collecté" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="950 K FCFA" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Add Button -->
                <Button Text="+ Nouvel événement" Style="{StaticResource PrimaryButton}" Clicked="OnAddEventClicked" Margin="0,4,0,8" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Tab Navigation -->
        <Border Grid.Row="2" Style="{StaticResource BottomNavBar}">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <!-- Accueil (Actif) -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Accueil" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="{StaticResource Primary}" CornerRadius="2" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Invites -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavInvitesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Invités" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Budget -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavBudgetTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Budget" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Taches -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTachesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Tâches" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Profil -->
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfilTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Profil" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
