<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.EnregistrerContributionPage"
             Title="Nouvelle contribution"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹ Retour" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                </HorizontalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Enregistrer une contribution" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Mariage Alain &amp; Rose" FontSize="12" TextColor="#DCE8E2" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Form ScrollView -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="14">
                <!-- Mode de paiement -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mode de paiement" Style="{StaticResource SectionTitle}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 20" Stroke="Transparent" Padding="16,8" Margin="0,0,8,6">
                            <Label Text="Orange Money" FontSize="13" FontAttributes="Bold" TextColor="White" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 20" Stroke="{StaticResource Border}" Padding="16,8" Margin="0,0,8,6">
                            <Label Text="MTN MoMo" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 20" Stroke="{StaticResource Border}" Padding="16,8" Margin="0,0,8,6">
                            <Label Text="Espèces" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Inputs Card -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nom du donateur" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="10,0" BackgroundColor="{StaticResource Surface}">
                                <Entry Placeholder="Nom de la personne ou famille" Style="{StaticResource StyledEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Montant versé (FCFA)" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="10,0" BackgroundColor="{StaticResource Surface}">
                                <Entry Placeholder="Montant en FCFA" Keyboard="Numeric" Style="{StaticResource StyledEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Numéro ou référence de transaction" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="10,0" BackgroundColor="{StaticResource Surface}">
                                <Entry Placeholder="Ex. Réf. transfert Orange / MTN" Style="{StaticResource StyledEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Message ou note (optionnel)" Style="{StaticResource CaptionText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="10,0" BackgroundColor="{StaticResource Surface}">
                                <Entry Placeholder="Note interne" Style="{StaticResource StyledEntry}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Button -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="14,10,14,16">
            <Button Text="Enregistrer" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked" />
        </Border>
    </Grid>
</ContentPage>
