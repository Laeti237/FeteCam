<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.InvitesPage"
             Title="Invités"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="#24FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 17" Padding="12,7" VerticalOptions="Center">
                        <Label FontSize="14" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="‹ " TextColor="{StaticResource Accent}" />
                                    <Span Text="Retour" TextColor="White" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Invités" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="SubtitleLabel" Text="Tous les événements" FontSize="12" TextColor="#DCE8E2" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="12">
                <!-- 3 Stats Counter Cards -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="8,10">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="ConfirmedCountLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}" HorizontalOptions="Center" />
                            <Label Text="Confirmés" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="8,10">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="WaitingCountLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}" HorizontalOptions="Center" />
                            <Label Text="En attente" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" Padding="8,10">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="AbsentCountLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}" HorizontalOptions="Center" />
                            <Label Text="Absents" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Search Input -->
                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Border}" BackgroundColor="{StaticResource Surface}" Padding="12,0" HeightRequest="44">
                    <Entry x:Name="SearchEntry" Placeholder="Rechercher un invité..." TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextTertiary}" FontSize="14" VerticalOptions="Center" TextChanged="OnSearchTextChanged" />
                </Border>

                <!-- Guest List -->
                <VerticalStackLayout x:Name="GuestsContainer" Spacing="12" />

                <!-- Add Button -->
                <Button Text="+ Ajouter un invité" Style="{StaticResource PrimaryButton}" Clicked="OnAddGuestClicked" Margin="0,4,0,8" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Tab Navigation -->
        <Border Grid.Row="2" Style="{StaticResource BottomNavBar}">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavAccueilTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Accueil" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Invites (Actif) -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Invités" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="{StaticResource Primary}" CornerRadius="2" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavBudgetTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Budget" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTachesTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Tâches" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfilTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Profil" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    <BoxView HeightRequest="3" WidthRequest="20" BackgroundColor="Transparent" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
