<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FeteCam.Views.NotificationsPage"
             Title="Notifications"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹ Retour" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                </HorizontalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Notifications" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Rappels et alertes en direct" FontSize="12" TextColor="#DCE8E2" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="14,14">
            <VerticalStackLayout Spacing="14">
                <!-- Preferences Card -->
                <Label Text="Canaux de notification" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Rappels SMS" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Échéances de tâches et alertes j-5" Style="{StaticResource CaptionText}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="True" OnColor="{StaticResource Primary}" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Notifications WhatsApp" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Réponses et présences des invités" Style="{StaticResource CaptionText}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="True" OnColor="{StaticResource Primary}" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Alertes de dépassement budget" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Dépenses au-delà du seuil fixé" Style="{StaticResource CaptionText}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="True" OnColor="{StaticResource Primary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Recent Notifications List -->
                <Label Text="Activité récente" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />

                <!-- Notification 1 -->
                <Border Style="{StaticResource CardFrame}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource SuccessLight}" Stroke="Transparent" VerticalOptions="Center">
                            <Label Text="OK" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Success}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Présence confirmée" Style="{StaticResource SectionTitle}" />
                            <Label Text="Paul Tchoumi a confirmé sa venue · Il y a 2h" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Notification 2 -->
                <Border Style="{StaticResource CardFrame}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource WarningLight}" Stroke="Transparent" VerticalOptions="Center">
                            <Label Text="FC" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Warning}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Contribution reçue" Style="{StaticResource SectionTitle}" />
                            <Label Text="50 000 FCFA reçus de Marie Ngono via Orange Money · Hier" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Notification 3 -->
                <Border Style="{StaticResource CardFrame}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource ErrorLight}" Stroke="Transparent" VerticalOptions="Center">
                            <Label Text="!" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Error}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Poste de dépense dépassé" Style="{StaticResource SectionTitle}" TextColor="{StaticResource Error}" />
                            <Label Text="Boissons a dépassé l'allocation initiale de 10 000 FCFA · 10 nov." Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Button -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeThickness="1" Padding="14,10,14,16">
            <Button Text="Tout marquer comme lu" Style="{StaticResource SecondaryButton}" Clicked="OnMarkAllReadClicked" />
        </Border>
    </Grid>
</ContentPage>
